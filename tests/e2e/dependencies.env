# Registry source is pinned for its deployment fixtures. Kind pulls its
# prebuilt runtime image directly instead of rebuilding or republishing it.
# Managed Agents compatibility intentionally follows the paired public backend
# images' latest tags; their shared OCI source revision selects the matching Helm chart source.
ORCA_AGENT_REGISTRY_REPOSITORY=streamnative/orca-agent-registry
ORCA_AGENT_REGISTRY_REF=637ba7ef2aa13d69a6d42a19c785b6f1f57f2801
ORCA_AGENT_REGISTRY_IMAGE=streamnative/pulsar-cloud:4.2.1.12
ORCA_MANAGED_AGENTS_REPOSITORY=orca-ae/orca-managed-agents
ORCA_MANAGED_AGENTS_REGISTRY_IMAGE=streamnative/orca-registry-service-ts
ORCA_MANAGED_AGENTS_HARNESS_IMAGE=streamnative/orca-harness-server
