#!/usr/bin/env bash

# Regenerates api.md from the compiler's view of the exported surface.
#
# Hand-maintained API indexes drift the moment someone forgets to update them,
# and a stale index is worse than none: it documents methods that no longer
# exist. This derives the whole file from `go doc`, so it can be regenerated and
# diffed rather than trusted.

set -euo pipefail

cd "$(dirname "$0")/.."

MODULE="$(go list -m)"

{
	echo "# API surface"
	echo
	echo "Generated by \`./scripts/generate-api-docs\` — do not edit by hand."
	echo
	echo "Full documentation: <https://pkg.go.dev/${MODULE}>"
	echo

	go doc -all . | awk '
		# Returns the last *TypeName in a line, which for a constructor is the
		# type it builds: both "... *Client) *CatalogClient" and
		# "... *http.Client) (*Client, error)" resolve correctly, the latter
		# because the package qualifier in *http.Client starts lowercase.
		function returned_type(line,   rest, out, m) {
			rest = line
			out = ""
			while (match(rest, /\*[A-Z][A-Za-z0-9]*/)) {
				m = substr(rest, RSTART + 1, RLENGTH - 1)
				out = m
				rest = substr(rest, RSTART + RLENGTH)
			}
			return out
		}

		/^func \([a-z]+ \*?[A-Z][A-Za-z0-9]*\)/ {
			recv = $3
			sub(/^\*/, "", recv)
			sub(/\)$/, "", recv)
			methods[recv] = methods[recv] $0 "\n"
			next
		}
		/^func New[A-Z]/ {
			target = returned_type($0)
			if (target == "") { funcs = funcs $0 "\n"; next }
			ctors[target] = ctors[target] $0 "\n"
			next
		}
		/^func [A-Z]/ { funcs = funcs $0 "\n"; next }
		/^type [A-Z]/ {
			name = $2
			order[++n] = name
			next
		}

		function emit_section(heading, want_client,   i, name, printed) {
			printed = 0
			for (i = 1; i <= n; i++) {
				name = order[i]
				if (done[name]) continue
				if (methods[name] == "" && ctors[name] == "") continue
				if ((name ~ /Client$/) != want_client) continue
				if (!printed) { print heading; print ""; printed = 1 }
				print "### " name
				print ""
				print "```go"
				printf "%s", ctors[name]
				printf "%s", methods[name]
				print "```"
				print ""
				done[name] = 1
			}
		}

		END {
			emit_section("## Clients", 1)
			emit_section("## Types with methods", 0)

			if (funcs != "") {
				print "## Package functions"
				print ""
				print "```go"
				printf "%s", funcs
				print "```"
				print ""
			}

			print "## Data types"
			print ""
			for (i = 1; i <= n; i++) {
				name = order[i]
				if (done[name]) continue
				print "- `" name "`"
			}
		}
	'
} > api.md

echo "==> Wrote api.md ($(wc -l < api.md | tr -d ' ') lines)"
